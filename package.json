{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "author": "r4ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r4ai/mercury.git"
  },
  "bugs": {
    "url": "https://github.com/r4ai/mercury/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs",
    "e2e"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "e2e": "turbo e2e",
    "changeset": "changeset",
    "release": "bun run publish",
    "publish": "for dir in packages/*; do (cd \"$dir\" && bun publish --ignore-scripts --tolerate-republish) || exit $?; done && changeset tag",
    "security:audit": "bun audit --audit-level=high",
    "version": "changeset version && bun update",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.29.8",
    "lefthook": "1.13.6",
    "shadcn": "3.5.0",
    "turbo": "2.9.14"
  },
  "overrides": {
    "@hono/node-server": "1.19.10",
    "@isaacs/brace-expansion": "5.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/browser": "3.2.7",
    "brace-expansion": "5.0.8",
    "defu": "6.1.7",
    "fast-uri": "3.1.4",
    "glob": "10.5.0",
    "hono": "4.12.32",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "minimatch": "10.2.5",
    "path-to-regexp": "8.4.0",
    "picomatch": "2.3.2",
    "playwright": "1.55.1",
    "postcss": "8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "rollup": "4.59.0",
    "serialize-javascript": "7.0.3",
    "tar": "7.5.22",
    "valibot": "1.2.0",
    "vite": "7.3.6",
    "vitest": "3.2.6",
    "ws": "8.21.0"
  },
  "packageManager": "bun@1.3.2",
  "trustedDependencies": [
    "@biomejs/biome",
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild",
    "lefthook",
    "msw"
  ]
}
